[user]
	name = Emil Teurnberg
	email = e.teurnberg@gmail.com
[core]
	excludesfile = $HOME/.gitignore_global
	editor = vim
[push]
	default = matching
#[pager]
#	log = diff-highlight | less
#	show = diff-highlight | less
#	diff = diff-highlight | less
[credential]
	helper = osxkeychain
[merge]
	conflictstyle = diff3
[rerere]
	enabled = true
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[fetch]
	prune = true
